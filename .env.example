# Copia este archivo a `.env.local` para desarrollo.
#
# Estas dos son PÚBLICAS por diseño: acaban dentro del bundle que se publica en
# GitHub Pages y cualquiera puede leerlas. Toda la seguridad vive en las
# policies RLS de Supabase, nunca en esconder la anon key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# SOLO para los scripts de ingesta (scripts/sync-lae.mjs).
# La service_role key SALTA LAS POLICIES RLS: da acceso total a la base.
# Va únicamente en los secrets del repo de GitHub. Que no aparezca nunca en
# una variable VITE_*, porque eso la metería en el bundle público.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
